generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Doctor Registry
model User {
  id           String        @id @default(uuid())
  doctorName   String
  email        String        @unique
  password     String
  hospitalName String // "Hospital 1" | "Hospital 2"
  cases        MedicalCase[]
  createdAt    DateTime      @default(now())
}

model MedicalCase {
  id           String   @id @default(uuid())
  patientCnic  String // search key
  hospitalName String
  diagnosis    String // AES-256-GCM ciphertext
  treatment    String // AES-256-GCM ciphertext
  medicines    String
  caseStatus   String   @default("PENDING") // PENDING | COMPLETED
  checkupDate  DateTime @default(now())

  doctorId String
  doctor   User   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([patientCnic])
}
